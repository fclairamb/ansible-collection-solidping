# {{ ansible_managed }}
# SP_* variables of the SolidPing service, loaded by its unit (EnvironmentFile=).
# Each one overrides the matching config.yml key (SP_DB_URL is db.url).
{% for key, value in solidping_env | dictsort %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
